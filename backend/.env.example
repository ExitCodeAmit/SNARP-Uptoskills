# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL (see DB_SETUP.md)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=snarp
PORT=5000
PGPOOL_MAX=10
PAPER_MAX_PDF_BYTES=10485760

# Login tokens. Use a long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required when NODE_ENV=production. In development a temporary one is made at start-up,
# which signs everyone out whenever the server restarts.
JWT_SECRET=
NODE_ENV=development

# Outgoing email (verification, resend and password reset).
# MAIL_PROVIDER: brevo (production, HTTPS API), smtp (local Gmail) or log (write emails to the server log).
# Leave it empty to choose automatically: Brevo when BREVO_API_KEY is set, else SMTP when SMTP_URL is set, else log.
MAIL_PROVIDER=

# Brevo (use on hosts that block SMTP ports, such as Render's free plan). Create an API key
# (not an SMTP key) in Brevo under SMTP & API > API Keys, and verify the sender address in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SNARP

# Gmail SMTP for local development. Turn on 2-step verification, create an App Password,
# and use it here (not your normal Gmail password):
#   SMTP_URL=smtps://your_email%40gmail.com:your_app_password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=SNARP <your_email@gmail.com>
# The address people open SNARP at; used for the links in emails.
APP_URL=http://localhost:5173

# Reels video storage (ImageKit). Leave empty to switch reel uploads off.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_id>

# Help assistant "SNARP Guide" and paper chat (Groq). Leave empty to switch them off.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Researcher matching AI smart-fill (Google Gemini). Optional: when set, paper chat also uses Gemini.
GEMINI_API_KEY=

# Demo seeding additionally requires NODE_ENV=development and ALLOW_DEMO_SEED=true.
# Only set this when the API is behind a trusted reverse proxy. On Render it defaults to 1 automatically.
# Use the proxy hop count (for example, 1) or trusted proxy IPs/CIDRs.
# Never use true; an incorrect value can let clients spoof their IP.
# TRUST_PROXY=
