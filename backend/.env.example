# Copy to .env and fill in your local PostgreSQL credentials
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<your_pg_admin_password>
PGDATABASE=snarp
PORT=5000
PAPER_MAX_PDF_BYTES=10485760

# Leave unset to generate a local JWT secret on first run.
JWT_SECRET=

# Groq AI API key for chat assistant (get from https://console.groq.com/keys)
# Required for AI-powered chat responses
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
