PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<your_pg_admin_password>
PGDATABASE=snarp
PORT=5000
PGPOOL_MAX=10
PAPER_MAX_PDF_BYTES=10485760


# Reels video storage (ImageKit). Leave empty to switch reel uploads off.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_id>

# Help assistant "SNARP Guide" (Groq). Leave empty to switch it off.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
