# Copy to .env and fill in your local PostgreSQL credentials
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<your_pg_admin_password>
PGDATABASE=snarp
PORT=5000
PGPOOL_MAX=10
PAPER_MAX_PDF_BYTES=10485760

# Leave unset for local development to generate a persistent secret on first run.
# Set a unique secret of at least 32 bytes through your production secret manager.
# JWT_SECRET=

# Only set this when the API is behind a trusted reverse proxy.
# Use the proxy hop count (for example, 1) or trusted proxy IPs/CIDRs.
# Never use true; an incorrect value can let clients spoof their IP.
# TRUST_PROXY=
