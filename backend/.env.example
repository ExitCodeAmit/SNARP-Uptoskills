# Copy to .env and fill in your local PostgreSQL credentials
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=snarp
PORT=5000
PAPER_MAX_PDF_BYTES=10485760

# Leave unset to generate a local JWT secret on first run.

# Demo seeding additionally requires NODE_ENV=development and ALLOW_DEMO_SEED=true.
